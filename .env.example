# Bu dosya SADECE örnektir. Gerçek değerleri `.env` dosyasına yaz (git'e girmez).
# Yalnızca PostgreSQL ile çalıştırırken gerekir; varsayılan çalıştırma bellek içi H2 kullanır.

POSTGRES_DB=perde
POSTGRES_USER=KULLANICI_ADI
POSTGRES_PASSWORD=SIFRE_BURAYA

# Backend'in bağlanacağı adres (docker-compose içinde servis adı "db")
PERDE_DB_URL=jdbc:postgresql://localhost:5432/perde
PERDE_DB_USER=KULLANICI_ADI
PERDE_DB_PASSWORD=SIFRE_BURAYA

# Arayüzün yayınlandığı adres(ler), virgülle ayrılır (CORS ve WebSocket için)
PERDE_ALLOWED_ORIGINS=http://localhost:5173
