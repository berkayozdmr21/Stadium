# Bu dosya SADECE örnektir. Gerçek değerleri `.env` dosyasına yaz (git'e girmez).
# Yalnızca PostgreSQL ile çalıştırırken gerekir; varsayılan çalıştırma bellek içi H2 kullanır.

# Backend'in bağlanacağı veritabanı
STADYUM_DB_URL=jdbc:postgresql://localhost:5432/stadyum
STADYUM_DB_USER=KULLANICI_ADI
STADYUM_DB_PASSWORD=SIFRE_BURAYA

# Arayüzün yayınlandığı adres(ler), virgülle ayrılır (CORS ve WebSocket için)
STADYUM_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo kalabalığı (rastgele koltuk tutan/satan simülasyon); gerçek kullanımda false yap
STADYUM_CROWD=true
